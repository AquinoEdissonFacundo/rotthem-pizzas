            {
              "type": "text",
              "id": "K8igGB",
              "name": "D Cierre",
              "fill": "$tinta",
              "textGrowth": "fixed-width",
              "width": 720,
              "content": "Después de darle muchas vueltas, quise formalizarlo: estudié en el IGA, en Asunción, y al graduarme trabajé en distintos restaurantes de la ciudad, aprendiendo un poco de cada uno. En uno de ellos empezó todo lo que vino después.",
              "lineHeight": 1.65,
