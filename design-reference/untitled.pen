                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Y mientras tanto, la cocina aparecía como mi momento feliz: eso que hacía sin que nadie me lo pidiera. Ahí estaba la señal.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
